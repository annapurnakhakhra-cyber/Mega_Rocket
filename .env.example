# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shopify-app

# Email Configuration (Gmail)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_specific_password

# Shopify Configuration
SHOPIFY_STORE_DOMAIN=your-shop-name.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Security
JWT_SECRET=your_super_secret_key_change_me_in_production
NEXTAUTH_SECRET=your_nextauth_secret_key
NEXTAUTH_URL=http://localhost:3000

# Optional: Port
PORT=3000
